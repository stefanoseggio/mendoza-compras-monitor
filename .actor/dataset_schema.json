{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "numeroProceso": { "title": "Numero Proceso", "type": "string", "description": "e.g. 10201-0001-CDI20" },
            "nombreProceso": { "title": "Nombre Proceso", "type": "string" },
            "tipoProceso": {
                "title": "Tipo Proceso",
                "type": "string",
                "description": "e.g. Contratacion Directa, Licitacion Publica"
            },
            "fechaApertura": { "title": "Fecha Apertura", "type": "string" },
            "estado": { "title": "Estado", "type": "string" },
            "unidadEjecutora": { "title": "Unidad Ejecutora", "type": "string" },
            "servicioAdministrativoFinanciero": { "title": "Servicio Administrativo Financiero", "type": "string" },
            "monto": { "title": "Monto", "type": "string" },
            "record_id": {
                "title": "Record ID",
                "type": "string",
                "description": "Same value as numeroProceso - stable across runs"
            },
            "event_type": {
                "title": "Event Type",
                "type": "string",
                "description": "NEW_LISTING (never seen before), STATUS_CHANGE (estado changed since last seen), UPDATED (a field changed, same estado) or UNCHANGED (only when Only new records is off)."
            },
            "scraped_at": {
                "title": "Scraped At",
                "type": "string",
                "description": "ISO-8601 timestamp of this extraction (same for every record in one run)"
            },
            "is_new": {
                "title": "Is New",
                "type": "boolean",
                "description": "true if not seen in a prior run (delta mode)"
            },
            "contentHash": {
                "title": "Content Hash",
                "type": "string",
                "description": "sha1 fingerprint of this record's changeable fields - used to detect UPDATED between runs."
            },
            "sourceUrlResolved": {
                "title": "Source URL Resolved",
                "type": "boolean",
                "description": "True when source_url is a genuine process-specific permalink; false when it's the generic search-page fallback."
            },
            "source_url": {
                "title": "Source URL",
                "type": "string",
                "description": "Direct, cookie-independent link to the official process page (or the generic search page - see sourceUrlResolved)"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "numeroProceso",
                    "nombreProceso",
                    "tipoProceso",
                    "estado",
                    "unidadEjecutora",
                    "monto",
                    "is_new"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "Numero", "format": "text", "field": "numeroProceso" },
                    { "label": "Nombre", "format": "text", "field": "nombreProceso" },
                    { "label": "Tipo", "format": "text", "field": "tipoProceso" },
                    { "label": "Estado", "format": "text", "field": "estado" },
                    { "label": "Unidad Ejecutora", "format": "text", "field": "unidadEjecutora" },
                    { "label": "Monto", "format": "text", "field": "monto" },
                    { "label": "Nuevo", "format": "boolean", "field": "is_new" }
                ]
            }
        },
        "changes": {
            "title": "Status changes & amendments",
            "transformation": {
                "fields": ["record_id", "event_type", "nombreProceso", "estado", "unidadEjecutora", "monto", "source_url", "scraped_at"]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "Numero", "format": "text", "field": "record_id" },
                    { "label": "Evento", "format": "text", "field": "event_type" },
                    { "label": "Nombre", "format": "text", "field": "nombreProceso" },
                    { "label": "Estado", "format": "text", "field": "estado" },
                    { "label": "Unidad Ejecutora", "format": "text", "field": "unidadEjecutora" },
                    { "label": "Monto", "format": "text", "field": "monto" },
                    { "label": "URL", "format": "link", "field": "source_url" },
                    { "label": "Detectado", "format": "date", "field": "scraped_at" }
                ]
            }
        }
    }
}
